{
    "entry": ["src/main.ts"],
    "project": ["src/**/*.ts"],
    "ignoreDependencies": [],
    "ignoreExportsUsedInFile": true,
    "paths": {
        "@/*": ["src/*"],
        "@core/*": ["src/core/*"],
        "@utils/*": ["src/utils/*"],
        "@config/*": ["src/config/*"],
        "@types/*": ["src/types/*"]
    }
}
